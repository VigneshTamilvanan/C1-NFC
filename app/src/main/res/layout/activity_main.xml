<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Screen 1: Trip Setup (no scroll, compact) -->
    <LinearLayout
        android:id="@+id/screenTripSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Moving Tech ETM"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Logout"
                android:textSize="11sp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp"/>

        <!-- Active trip banner -->
        <LinearLayout
            android:id="@+id/bannerTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1565C0"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tvActiveTripBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trip — | Route —"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Route -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Route" android:textColor="#444444" android:textSize="12sp"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:id="@+id/tvRouteFixed"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:textSize="15sp"
            android:textColor="#1A237E"
            android:textStyle="bold"
            android:background="#E8EAF6"
            android:layout_marginBottom="10dp"
            android:text="—"/>
        <Spinner
            android:id="@+id/spinnerRoute"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <!-- Source -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Source" android:textColor="#444444" android:textSize="12sp"
            android:layout_marginBottom="2dp"/>
        <Spinner
            android:id="@+id/spinnerSource"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/btn_dropdown"
            android:padding="8dp"/>

        <!-- Destination -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Destination" android:textColor="#444444" android:textSize="12sp"
            android:layout_marginBottom="2dp"/>
        <Spinner
            android:id="@+id/spinnerDest"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@android:drawable/btn_dropdown"
            android:padding="8dp"/>

        <!-- Fare + Passengers row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fare (₹)" android:textColor="#444444" android:textSize="12sp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Passengers" android:textColor="#444444" android:textSize="12sp"
                android:paddingStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/inputFare"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="e.g. 25"
                android:inputType="numberDecimal"
                android:padding="10dp"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp">
                <Button
                    android:id="@+id/btnPassMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="-"
                    android:textSize="18sp"
                    android:padding="0dp"
                    android:backgroundTint="#9E9E9E"
                    android:textColor="#FFFFFF"/>
                <TextView
                    android:id="@+id/tvPassCount"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:gravity="center"
                    android:textAlignment="center"/>
                <Button
                    android:id="@+id/btnPassPlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="+"
                    android:textSize="18sp"
                    android:padding="0dp"
                    android:backgroundTint="#1A237E"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnStartCollection"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="START COLLECTION"
            android:textSize="15sp"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnValidateQr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="VALIDATE QR TICKET"
            android:textSize="14sp"
            android:backgroundTint="#F57F17"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Screen 2: Tap Screen -->
    <LinearLayout
        android:id="@+id/screenTap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tapRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route 21"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tapJourney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koyambedu → Adyar"
            android:textSize="18sp"
            android:textColor="#444444"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tapFare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹25"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:textAlignment="center"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask passenger to tap phone"
            android:textSize="16sp"
            android:textColor="#888888"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="TAP / PAY NOW"
            android:textSize="18sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnEditTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Trip"
            android:textSize="14sp"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Screen 3: Result -->
    <LinearLayout
        android:id="@+id/screenResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TICKET ISSUED"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/resultTicketNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ticket #: —"
            android:textSize="20sp"
            android:textColor="#1A237E"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/resultTxnId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Txn: —"
            android:textSize="13sp"
            android:textColor="#888888"
            android:textAlignment="center"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/resultJourney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#444444"
            android:textAlignment="center"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnNextPassenger"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="NEXT PASSENGER"
            android:textSize="18sp"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Screen 4: QR Validation (camera only, no paste) -->
    <LinearLayout
        android:id="@+id/screenQr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QR Validation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:textAlignment="center"
            android:layout_marginBottom="32dp"/>

        <!-- Result card (hidden until scan) -->
        <LinearLayout
            android:id="@+id/qrResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivQrPhoto"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvQrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvQrDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#444444"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SCAN AGAIN"
            android:textSize="16sp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- keep these IDs to avoid compile errors, but hidden -->
        <EditText
            android:id="@+id/inputQrContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/btnCheckQr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnQrBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK"
            android:textSize="14sp"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</FrameLayout>
