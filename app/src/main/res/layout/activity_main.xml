<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Screen 1: Trip Setup -->
    <ScrollView
        android:id="@+id/screenTripSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chennai One — ETM"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"/>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textSize="12sp"
                    android:backgroundTint="#B71C1C"
                    android:textColor="#FFFFFF"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvConductor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginBottom="4dp"/>

            <!-- Active trip banner -->
            <LinearLayout
                android:id="@+id/bannerTrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1565C0"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/tvActiveTripBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trip — | Route —"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Route" android:textColor="#444444" android:textSize="13sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tvRouteFixed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:textSize="16sp"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:background="#E8EAF6"
                android:layout_marginBottom="20dp"
                android:text="—"/>
            <!-- Hidden spinner kept for compat; invisible -->
            <Spinner
                android:id="@+id/spinnerRoute"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Source" android:textColor="#444444" android:textSize="13sp"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerSource"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@android:drawable/btn_dropdown"
                android:padding="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Destination" android:textColor="#444444" android:textSize="13sp"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerDest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@android:drawable/btn_dropdown"
                android:padding="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fare (₹)" android:textColor="#444444" android:textSize="13sp"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/inputFare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. 25"
                android:inputType="numberDecimal"
                android:layout_marginBottom="32dp"
                android:padding="10dp"/>

            <Button
                android:id="@+id/btnStartCollection"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="START COLLECTION"
                android:textSize="16sp"
                android:backgroundTint="#1A237E"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnValidateQr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="VALIDATE QR TICKET"
                android:textSize="15sp"
                android:backgroundTint="#F57F17"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

    <!-- Screen 2: Tap Screen -->
    <LinearLayout
        android:id="@+id/screenTap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tapRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route 21"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tapJourney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koyambedu → Adyar"
            android:textSize="18sp"
            android:textColor="#444444"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tapFare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹25"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:textAlignment="center"
            android:layout_marginBottom="48dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask passenger to tap phone"
            android:textSize="16sp"
            android:textColor="#888888"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="TAP / PAY NOW"
            android:textSize="18sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnEditTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Trip"
            android:textSize="14sp"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Screen 3: Result -->
    <LinearLayout
        android:id="@+id/screenResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TICKET ISSUED"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/resultTicketNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ticket #: —"
            android:textSize="20sp"
            android:textColor="#1A237E"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/resultTxnId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Txn: —"
            android:textSize="13sp"
            android:textColor="#888888"
            android:textAlignment="center"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/resultJourney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#444444"
            android:textAlignment="center"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnNextPassenger"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="NEXT PASSENGER"
            android:textSize="18sp"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Screen 4: QR Validation -->
    <LinearLayout
        android:id="@+id/screenQr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Validate QR Ticket"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan QR or paste content below"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SCAN QR CODE"
            android:textSize="16sp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— or paste QR content manually —"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:textAlignment="center"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/inputQrContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste QR payload here..."
            android:minLines="3"
            android:maxLines="5"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCheckQr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VALIDATE"
            android:textSize="15sp"
            android:backgroundTint="#F57F17"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <!-- Result card -->
        <LinearLayout
            android:id="@+id/qrResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvQrDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#444444"
                android:lineSpacingExtra="6dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnQrBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK TO TICKET"
            android:textSize="14sp"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</FrameLayout>
